{
  "name": "safeer-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:e2e": "ng build -c e2e",
    "build:ci": "ng build && node scripts/check-gzip-budget.mjs && node scripts/check-prod-artifact.mjs && ng build -c e2e",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:server": "vitest run --config vitest.server.config.mts",
    "lint": "ng lint && node scripts/lint-styles.mjs && prettier --check \"src/**/*.{ts,html,css}\" \"e2e/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" \"mocks/**/*.{mjs,json}\"",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"e2e/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" \"mocks/**/*.{mjs,json}\"",
    "budget:gzip": "node scripts/check-gzip-budget.mjs",
    "check:prod-artifact": "node scripts/check-prod-artifact.mjs",
    "e2e": "playwright test",
    "e2e:full": "E2E_FULL_MATRIX=1 playwright test",
    "mock-api": "node e2e/mock-api/server.mjs",
    "serve:ssr": "node dist/safeer_web/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/platform-server": "22.2.0",
    "@angular/router": "22.2.0",
    "@angular/ssr": "22.2.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@jsverse/transloco": "8.4.0",
    "express": "5.2.1",
    "http-proxy-middleware": "4.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "angular-eslint": "22.5.0",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "lucide-static": "1.48.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": "^22.22.0 || >=24.15.0"
  }
}

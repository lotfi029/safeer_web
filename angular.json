{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "angular-eslint"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "safeer_web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "ibm-plex-sans-arabic-{arabic,latin}-{300,400,500,600,700}-normal.woff2",
                "input": "node_modules/@fontsource/ibm-plex-sans-arabic/files",
                "output": "fonts"
              },
              {
                "glob": "ibm-plex-sans-{latin,latin-ext}-{400,500,600,700}-normal.woff2",
                "input": "node_modules/@fontsource/ibm-plex-sans/files",
                "output": "fonts"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "localhost",
                "127.0.0.1"
              ]
            },
            "ssr": {
              "entry": "src/server.ts"
            },
            "index": {
              "input": "src/index.html",
              "preloadInitial": false
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "480kB",
                  "maximumError": "520kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/app/core/api/mocks/mock-interceptors.ts",
                  "with": "src/app/core/api/mocks/mock-interceptors.prod.ts"
                },
                {
                  "replace": "src/app/features/kit/kit.routes.ts",
                  "with": "src/app/features/kit/kit.routes.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            },
            "e2e": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "480kB",
                  "maximumError": "520kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "outputPath": "dist/safeer_web-e2e",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.e2e.ts"
                },
                {
                  "replace": "src/app/core/api/mocks/mock-interceptors.ts",
                  "with": "src/app/core/api/mocks/mock-interceptors.prod.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "safeer_web:build:production"
            },
            "development": {
              "buildTarget": "safeer_web:build:development"
            },
            "e2e": {
              "buildTarget": "safeer_web:build:e2e"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "include": [
              "src/**/*.spec.ts"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  }
}

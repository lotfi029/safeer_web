# Copy to .env (never commit .env). server.ts loads it at start-up; PM2/hPanel env vars also work.

# Origin of the NestJS API on the internal network (no /api/v1 suffix). Must NOT be publicly reachable.
API_INTERNAL_URL=http://127.0.0.1:3000

# Public origin of this site. Its host (+ www) is the only Host Angular SSR accepts in production.
PUBLIC_SITE_URL=https://safeer-sa.org

# Port the SSR server listens on.
PORT=4000

# Number of reverse proxies in front of this server (Hostinger edge = 1). Used for the client IP.
TRUST_PROXY=1

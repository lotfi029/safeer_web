# Copy to .env (never commit .env). server.ts loads it at start-up; PM2/hPanel env vars also work.
# In Docker (safeer_api deploy/docker-compose.yml) these are set by the compose file instead.

# Origin of the NestJS API on the internal network (no /api/v1 suffix). Must NOT be publicly reachable.
# safeer_api listens on 3900; in the Docker stack this is http://api:3900.
API_INTERNAL_URL=http://127.0.0.1:3900

# Public origin of this site. Its host (+ www) is the only Host Angular SSR accepts in production.
PUBLIC_SITE_URL=https://safeer-sa.org

# Address and port the SSR server listens on. 127.0.0.1 keeps a bare-host server reachable only
# through its reverse proxy; the Docker image sets HOST=0.0.0.0.
HOST=127.0.0.1
PORT=4000

# Number of reverse proxies in front of this server (the edge Caddy = 1). Used for the client IP.
TRUST_PROXY=1
